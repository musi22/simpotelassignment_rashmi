# Hotel Guest Assistant Environment Variables

# Demo Mode (default: true for instant zero-config runnability)
# Set to false if you wish to enforce real LLM execution
DEMO_MODE=true

# Real AI Provider Configuration (optional)
# When provided and DEMO_MODE=false, requests will use this API key.
# Real model failures will never silently switch to demo mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Alternatively, Google Gemini API Key
GEMINI_API_KEY=
